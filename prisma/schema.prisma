// SPEX Platform — Production Database Schema (PostgreSQL)
// قاعدة البيانات الإنتاجية الحقيقية للمنصة

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------
// المستخدمون — النموذج الوحيد الذي يحتاج أعمدة صارمة لأنه يحمل بيانات المصادقة
// -----------------------------------------------------------------------
model User {
  id                String   @id
  username          String   @unique
  spexId            String   @unique
  firstName         String
  lastName          String
  email             String   @unique
  // كلمة المرور لا تُخزَّن أبداً كنص عادي — فقط الهاش (bcrypt)
  passwordHash      String
  // معرّف حساب Google المرتبط (Google "sub") — اختياري، يُستخدم لتسجيل الدخول عبر Google
  // بدل/بالإضافة إلى كلمة المرور. لا يزال الحساب نفسه يُنشأ حصرياً من طرف المشرف أو المفتش.
  googleId          String?  @unique
  role              String // teacher | inspector | director | admin
  avatar            String?
  phone             String?
  directorateId     String
  districtId        String
  institutionId     String?
  schoolName        String?
  municipality      String?
  specialization    String?
  cycle             String?
  yearsExperience   Int?
  bio               String?
  status            String   @default("active") // active | inactive
  isApprovedByAdmin Boolean  @default(false)
  followingIds      String[] @default([])
  followersIds      String[] @default([])
  publishedResourcesCount Int @default(0)
  approvedResourcesCount  Int @default(0)
  privacySettings   Json?
  // مفتاح Gemini الخاص بالمستخدم (اختياري) — يُستخدم فقط من الخادم، لا يُعرض للعميل بعد الحفظ
  customApiKey      String? // legacy only; no longer returned or used for AI calls
  encryptedApiKey   String?
  apiKeyStatus      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // بلدية العمل كسجل مرتبط فعلياً بجدول Municipalities (municipality أعلاه يبقى كاسم نصي مخزَّن للعرض السريع فقط)
  municipalityId    String?

  // الحقول الجغرافية الوطنية الجديدة (PART A) — اختيارية معكوسة للتوافق
  eduDirectorateId String?
  eduDirectorate Directorate? @relation("EduDirectorate", fields: [eduDirectorateId], references: [id], onDelete: SetNull)
  eduDistrictId String?
  eduDistrict InspectionDistrict? @relation("EduDistrict", fields: [eduDistrictId], references: [id], onDelete: SetNull)
  eduSchoolId String?
  eduSchool School? @relation("EduSchool", fields: [eduSchoolId], references: [id], onDelete: SetNull)
  birthDate DateTime?

  resetTokens PasswordResetToken[]
  pedagogicalGames PedagogicalGame[]
  generationAccess UserGenerationAccess?
  students Student[]
  studentClasses StudentClass[]

  // نظام الإسناد التلقائي للأساتذة إلى المفتشين
  teacherAssignment    InspectorAssignment?  @relation("TeacherAssignment")
  inspectorAssignments InspectorAssignment[] @relation("InspectorAssignments")

  @@index([role])
  @@index([directorateId])
  @@index([districtId])
  @@index([municipalityId])
  @@index([eduDirectorateId])
  @@index([eduDistrictId])
  @@index([eduSchoolId])
}

model Student {
  id            String   @id
  teacherId     String
  institutionId String?
  classId       String
  matricule     String
  firstName     String
  lastName      String
  birthDate     DateTime?
  grade         Int?
  groupName     String?
  schoolYear    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  teacher       User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([institutionId, matricule])
  @@index([teacherId, classId])
  @@index([institutionId])
}

model StudentClass {
  id            String   @id
  teacherId     String
  institutionId String?
  levelId       String
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  teacher       User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([institutionId])
}

// -----------------------------------------------------------------------
// نظام الإسناد التلقائي للأساتذة إلى المفتشين
// Directorates / Municipalities / Schools / InspectionDistricts هي الهيكل
// الإداري الرسمي، وتُدار من طرف الإدارة (admin) عبر مسارات مخصصة، بينما
// InspectorAssignment هو ناتج منطق الإسناد التلقائي المحسوب من طرف الخادم.
// -----------------------------------------------------------------------

model Directorate {
  id         String   @id
  name       String // e.g. مديرية التربية لولاية سطيف
  wilayaCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  municipalities Municipality[]
  districts      InspectionDistrict[]
  eduUsers       User[] @relation("EduDirectorate")

  @@index([name])
}

model Municipality {
  id            String   @id @default(cuid())
  name          String
  directorateId String
  directorate   Directorate @relation(fields: [directorateId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  schools     School[]
  suggestions MunicipalitySuggestion[]

  @@unique([directorateId, name])
  @@index([directorateId])
}

model School {
  id             String   @id @default(cuid())
  name           String
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  suggestions SchoolSuggestion[]

  // PART A additions
  inspectionDistrictId String?
  inspectionDistrict InspectionDistrict? @relation("SchoolInspectionDistrict", fields: [inspectionDistrictId], references: [id], onDelete: SetNull)
  wilayaCode String?
  eduUsers User[] @relation("EduSchool")

  @@unique([municipalityId, name])
  @@index([municipalityId])
  @@index([inspectionDistrictId])
}

model InspectionDistrict {
  id             String   @id @default(cuid())
  name           String // e.g. المقاطعة 07 - عين أزال
  directorateId  String
  directorate    Directorate @relation(fields: [directorateId], references: [id], onDelete: Cascade)
  districtNumber Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  eduUsers User[] @relation("EduDistrict")
  schools School[] @relation("SchoolInspectionDistrict")
  schoolSuggestions SchoolSuggestion[]

  @@unique([directorateId, name])
  @@index([directorateId])
}

// اقتراح إضافة بلدية غير موجودة في القائمة — يقدّمه الأستاذ أثناء استكمال بياناته،
// ولا يظهر لبقية المستخدمين حتى تعتمده الإدارة (يتحول عندها إلى سجل Municipality حقيقي)
model MunicipalitySuggestion {
  id            String   @id @default(cuid())
  name          String
  directorateId String
  municipality  Municipality? @relation(fields: [approvedMunicipalityId], references: [id], onDelete: SetNull)
  approvedMunicipalityId String?
  suggestedBy   String // User.id لصاحب الاقتراح
  status        String   @default("pending") // pending | approved | rejected
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([directorateId])
  @@index([status])
}

// اقتراح إضافة مؤسسة تعليمية غير موجودة في القائمة
model SchoolSuggestion {
  id             String   @id @default(cuid())
  name           String
  municipalityId String
  school         School?  @relation(fields: [approvedSchoolId], references: [id], onDelete: SetNull)
  approvedSchoolId String?
  suggestedBy    String
  status         String   @default("pending") // pending | approved | rejected
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())

  // PART A addition
  inspectionDistrictId String?
  inspectionDistrict InspectionDistrict? @relation(fields: [inspectionDistrictId], references: [id], onDelete: SetNull)

  @@index([municipalityId])
  @@index([status])
  @@index([inspectionDistrictId])
}

// سجل الإسناد: كل أستاذ يملك سجلاً واحداً فقط (@unique على teacherId)، والمفتش
// يمكن أن يظهر في عدة سجلات (علاقة واحد-إلى-متعدد حقيقية عبر جدول Postgres، وليس
// حساباً في الذاكرة)
model InspectorAssignment {
  id          String    @id @default(cuid())
  teacherId   String    @unique
  teacher     User      @relation("TeacherAssignment", fields: [teacherId], references: [id], onDelete: Cascade)
  inspectorId String?
  inspector   User?     @relation("InspectorAssignments", fields: [inspectorId], references: [id], onDelete: SetNull)
  status      String    @default("Pending") // Pending | Active | Changed | Removed
  assignedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([inspectorId])
  @@index([status])
}

// رموز استرجاع كلمة المرور عبر البريد الإلكتروني — رمز واحد صالح لمرة واحدة فقط
// نخزّن هاش الرمز فقط (وليس الرمز نفسه)، تماماً كما لا نخزّن كلمات المرور نص عادي
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// -----------------------------------------------------------------------
// بقية المجموعات: هيكلها الحالي معقد ومتغيّر في الواجهة الأمامية، لذا تُخزَّن
// كـ JSON منظم داخل أعمدة Postgres حقيقية (وليس ملف JSON على القرص) مع أعمدة
// مفهرسة إضافية للاستعلامات الشائعة والصلاحيات.
// -----------------------------------------------------------------------

model LessonPlan {
  id        String   @id
  ownerId   String?
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model EducationalSituation {
  id                  String   @id
  externalId          String?  @unique
  name                String
  grade               Int
  fieldId             String
  fieldName           String
  objectiveIds        String[]
  objectiveTexts      String[]
  sourceGoal          String
  organization        String
  equipment           String[]
  variations          String?
  origin              String
  status              String   @default("PRIVATE")
  ownerId             String?
  approvedById        String?
  approvedByRole      String?
  approvedAt          DateTime?
  rejectedById        String?
  rejectedByRole      String?
  rejectedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([grade, fieldId, status])
  @@index([ownerId, status])
}

model PedagogicalGame {
  id                String   @id
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  grade             Int
  fieldId           String
  fieldName         String
  objectiveId       String?
  objectiveText     String
  pedagogicalPurpose String
  organization      String
  description       String
  rules             String
  equipment         String[] @default([])
  executionGuidance String?
  safetyGuidance    String?
  progression       String?
  origin            String   @default("TEACHER")
  status            String   @default("DRAFT")
  approved          Boolean  @default(false)
  submittedAt      DateTime?
  approvedAt       DateTime?
  approvedById     String?
  rejectedAt       DateTime?
  rejectedById     String?
  rejectionReason  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([grade])
  @@index([fieldId])
  @@index([createdAt])
  @@index([status, grade, fieldId])
}

model NotebookEntry {
  id        String   @id
  ownerId   String?
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model InspectorNote {
  id        String   @id
  authorId  String?
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model DistrictMessage {
  id        String   @id
  authorId  String?
  districtId String?
  content   String?
  data      Json
  createdAt DateTime @default(now())

  @@index([authorId])
  @@index([districtId, createdAt])
}

model DirectMessage {
  id           String   @id
  senderId     String?
  recipientId  String?
  content      String?
  readAt       DateTime?
  data         Json
  createdAt    DateTime @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

model CommunityResource {
  id        String   @id
  authorId  String?
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model CommunityNotification {
  id         String   @id
  userId     String?
  senderId   String?
  type       String?
  title      String?
  message    String?
  read       Boolean  @default(false)
  readAt     DateTime?
  data       Json
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([userId, read, createdAt])
}

// -----------------------------------------------------------------------
// المخطط السنوي والتوزيع السنوي — يعدّل الأستاذ صياغة الأهداف التعلمية الخاصة
// به، ويمكن للمفتش اقتراح مخطط/توزيع سنوي لأساتذة مقاطعته (وفق الإسناد الفعلي
// في InspectorAssignment) ثم اعتماد اقتراحه ليصبح نافذاً عند الأستاذ.
// كل سجل فريد بـ (الأستاذ، السنة الدراسية، المستوى، النوع: مخطط/توزيع)
// -----------------------------------------------------------------------
model AnnualPlan {
  id                     String    @id
  teacherId              String
  academicYearId         String
  levelId                String
  kind                   String // 'plan' (المخطط السنوي) | 'schedule' (التوزيع السنوي)
  status                 String    @default("draft") // draft | proposed | approved
  proposedByInspectorId  String?
  approvedAt             DateTime?
  data                   Json // { overrides: { "<fieldId>__<sessionNumber>": { objective } }, note? }
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([teacherId, academicYearId, levelId, kind])
  @@index([teacherId])
  @@index([proposedByInspectorId])
  @@index([status])
}

// -----------------------------------------------------------------------
// إعداد مزودات الذكاء الاصطناعي التي يضيفها مشرف المنظومة من لوحة التحكم.
// التخزين خادمي حقيقي في Postgres؛ المفتاح يُشفَّر عند الراحة (encryptedApiKey)
// ولا يُعاد أبداً إلى الواجهة. عند تعذّر قاعدة البيانات يعمل النظام على مزودات
// البيئة (env) فقط حتى لا تتعطل المنصة.
// -----------------------------------------------------------------------
model AIProviderConfig {
  id              String    @id @default(cuid())
  name            String // اسم العرض، مثال: "DeepSeek" أو "مزودي الخاص"
  type            String    @default("openai-compatible") // openai-compatible | openai | nvidia | anthropic | gemini | ollama
  baseUrl         String? // مطلوب للمزودات المتوافقة مع OpenAI و ollama
  encryptedApiKey String? // مُشفَّر باستخدام encryptApiKey (AES-256-GCM)
  model           String? // اسم النموذج
  enabled         Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled])
}

model GenerationServiceConfig {
  id          String   @id
  enabled     Boolean  @default(true)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserGenerationAccess {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled               Boolean  @default(false)
  assistantEnabled      Boolean  @default(false)
  gameSuggestionsEnabled Boolean @default(false)
  provider              String   @default("gemini")
  encryptedApiKey       String?
  credentialEnabled     Boolean  @default(false)
  updatedByAdminId      String?
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([enabled])
}
