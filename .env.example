# ============ SPEX — المتغيرات البيئية ============
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية:
#   cp .env.example .env

# ---------- التطبيق ----------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# مفتاح توقيع JWT (أي قيمة طويلة وعشوائية)
JWT_SECRET=

# مفتاح تشفير مفاتيح مزودات الذكاء الاصطناعي في قاعدة البيانات (32 حرفاً على الأقل)
API_KEY_ENCRYPTION_SECRET=

# سرّ الإعداد الأولي (لإنشاء حساب المشرف عبر /api/setup)
SETUP_SECRET=

# ---------- قاعدة البيانات (Neon PostgreSQL) ----------
# رابط Neon pooled للتشغيل (يحتوي عادةً على -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@PROJECT-pooler.REGION.aws.neon.tech/dbname?sslmode=require
# رابط Neon direct صريح للهجرات والوصول الإداري (بدون -pooler)
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@PROJECT.REGION.aws.neon.tech/dbname?sslmode=require

# ---------- حساب المشرف الأول (npm run db:seed) ----------
SUPER_ADMIN_EMAIL=admin@spex.dz
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=مشرف
SUPER_ADMIN_LAST_NAME=المنظومة الرقمية
SUPER_ADMIN_DIRECTORATE_ID=setif_de
SUPER_ADMIN_DISTRICT_ID=dist_setif_7

# ---------- البريد (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM=SPEX <onboarding@resend.dev>

# ---------- Google OAuth (اختياري) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# ---------- مزودات الذكاء الاصطناعي (اختياري — يكفي مزود واحد) ----------
# NVIDIA
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ---------- Google OAuth (تسجيل الدخول عبر Google — اختياري) ----------
# أنشئ "OAuth Client ID" من نوع Web في Google Cloud Console، وأضف نطاق المنصة
# (مثل https://your-app.onrender.com) ضمن Authorized JavaScript origins.
# GOOGLE_CLIENT_ID يستعمله الخادم للتحقق من الرموز، و VITE_GOOGLE_CLIENT_ID
# (نفس القيمة عادة) تُضمَّن في الواجهة لعرض زر Google الرسمي.
# عند غيابهما: يظهر زر Google معطّلاً بأمان والمصادقة العادية تعمل بشكل كامل.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# مزود متوافق مع OpenAI (OpenRouter, Groq, ...)
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_MODEL=

# Ollama (محلي)
OLLAMA_ENABLED=false
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# ---------- تطوير (اختياري) ----------
DISABLE_HMR=false
