# SPEX Platform — Environment Variables
# انسخ هذا الملف إلى .env محلياً، ولا ترفع .env أبداً إلى Git

# قاعدة البيانات — رابط الاتصال بـ Postgres (مثال Neon: يحتوي على sslmode=require)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# مفتاح توقيع الجلسات (JWT) — يجب أن يكون عشوائياً بطول 32 حرفاً على الأقل
# ولّده بأمر: openssl rand -base64 48
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# مفتاح Gemini API الافتراضي للمنصة (اختياري إن كان كل مستخدم سيضيف مفتاحه الخاص)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# خدمة البريد الإلكتروني (Resend) — لإرسال روابط إعادة تعيين كلمة المرور
# أنشئ حساباً مجانياً على https://resend.com واحصل على مفتاحك من لوحة التحكم
RESEND_API_KEY=""
# عنوان المُرسِل. للتجربة السريعة يمكن استخدام onboarding@resend.dev بدون ربط نطاق،
# لكن للإنتاج الفعلي يُفضّل ربط نطاقك الخاص من إعدادات Resend (مثال: SPEX <no-reply@yourdomain.dz>)
EMAIL_FROM="SPEX <onboarding@resend.dev>"
# رابط المنصة العلني — يُستخدم لبناء رابط إعادة تعيين كلمة المرور داخل البريد المُرسَل
APP_URL="http://localhost:3000"

# رمز سرّي مؤقت لإنشاء أول حساب مشرف بدون الحاجة لوصول Shell (استضافات مجانية كثيرة لا توفره)
# ولّده بنفس طريقة JWT_SECRET، واحذفه من متغيرات البيئة بعد إنشاء حساب المشرف الأول
# (غير ضروري إن استخدمت متغيرات SUPER_ADMIN_* أدناه لإنشاء الحساب تلقائياً)
SETUP_SECRET=""

# -----------------------------------------------------------------------
# إنشاء حساب SUPER_ADMIN تلقائياً عند أول إقلاع للخادم (اختياري لكن موصى به)
# إن عرّفت البريد وكلمة المرور هنا، سيقوم `npm start` بإنشاء الحساب تلقائياً
# (عبر prisma/seed.ts) قبل تشغيل الخادم، دون الحاجة لأي Shell أو bootstrap-admin.
# الأمر آمن لإعادة التشغيل: إن كان الحساب موجوداً مسبقاً لن يُعاد إنشاؤه أو تعديله.
# -----------------------------------------------------------------------
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_FIRST_NAME="مدير"
SUPER_ADMIN_LAST_NAME="المنصة"
SUPER_ADMIN_DIRECTORATE_ID="setif_de"
SUPER_ADMIN_DISTRICT_ID="dist_setif_7"

# بيئة التشغيل
NODE_ENV="production"

# المنفذ (تحدده منصة الاستضافة تلقائياً غالباً، اتركه إن لم تكن متأكداً)
PORT=3000
